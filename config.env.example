# lad-outlook-mcp – Einstellungen
# Kopieren nach ~/.config/lad-outlook-mcp/config.env und "chmod 600" setzen.
# Ausführliche Erklärung: README.md, Teil C.

# --- App (optional) -----------------------------------------------------------
# Leer lassen = Standard: Microsoft-App "Graph Command Line Tools", keine Registrierung nötig.
# Eigene App (README Teil A, Variante 1/2): Werte eintragen und "#" entfernen.
#OUTLOOK_CLIENT_ID=00000000-0000-0000-0000-000000000000
#OUTLOOK_TENANT_ID=00000000-0000-0000-0000-000000000000
# Nur bei eigener App mit Secret (Variante 1):
#OUTLOOK_CLIENT_SECRET=
#OUTLOOK_REDIRECT_URI=http://localhost:3333/auth/callback

# --- Rechte und Regeln --------------------------------------------------------
# readonly | draft | send
OUTLOOK_MODE=send

# Empfänger-Erlaubtliste (kommagetrennt). Beide Zeilen leer = alle Empfänger erlaubt.
# Empfohlen: hier die eigenen Domains bzw. Adressen eintragen, z. B.
#   OUTLOOK_ALLOWED_RECIPIENT_DOMAINS=example.com,example.net
#   OUTLOOK_ALLOWED_RECIPIENTS=steuerberater@example.net
OUTLOOK_ALLOWED_RECIPIENT_DOMAINS=
OUTLOOK_ALLOWED_RECIPIENTS=

# auto | always | never
OUTLOOK_CONFIRM_SEND=auto
